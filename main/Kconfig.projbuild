menu "Carbot micro-ROS settings"

    config CARBOT_MICRO_ROS_ENABLED
        bool "Enable micro-ROS cmd_vel bridge"
        default y

    config CARBOT_MICRO_ROS_TASK_STACK
        int "micro-ROS task stack (bytes)"
        default 16384
        range 4096 65536

    config CARBOT_MICRO_ROS_TASK_PRIO
        int "micro-ROS task priority"
        default 5
        range 1 24

    config CARBOT_MICRO_ROS_DOMAIN_ID
        int "ROS domain id"
        default 0
        range 0 232

    config CARBOT_MICRO_ROS_NAMESPACE
        string "ROS namespace"
        default ""

    config CARBOT_MICRO_ROS_CMD_VEL_TIMEOUT_MS
        int "cmd_vel timeout (ms)"
        default 500
        range 50 10000

    config CARBOT_MICRO_ROS_SPIN_PERIOD_MS
        int "Executor spin period (ms)"
        default 50
        range 5 1000

endmenu
